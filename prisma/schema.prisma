// Prisma schema for the SAT/ACT tutoring site.
// Database: PostgreSQL (works with local Postgres, Neon, Supabase, or Vercel Postgres).
// Quick start without migrations: `npx prisma db push` then `npm run db:seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  isPaid       Boolean   @default(false) // enrollment: only paid students can practice
  createdAt    DateTime  @default(now())
  sessions     Session[]
  attempts     Attempt[]
  timedSubmissions TimedSubmission[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Question {
  id           String   @id @default(cuid())
  slug         String?  @unique // stable key for seed sync (e.g. "unit-1-01"); null for legacy rows until backfilled
  subject      String   // unit-1 | unit-2 | unit-3 | unit-4
  domain       String?  // legacy topic grouping; section is the primary organizer now
  section      String?  // official CB section, e.g. "1.4"
  title        String?  // short display title, e.g. "Average Rate of Change"
  difficulty   String   @default("medium") // easy | medium | hard
  prompt       String   @db.Text
  choices      Json?    // string[] for multiple-choice; null for grid-in
  correctIndex Int?     // index into choices for multiple-choice
  correctText  String   // canonical correct answer (also used for grid-in checking)
  explanation  String   @db.Text
  createdAt    DateTime @default(now())
  attempts     Attempt[]

  @@index([subject, domain])
  @@index([subject, section])
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correct    Boolean
  timeMs     Int?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  test      String   // SAT | ACT | Both | Not sure
  message   String   @db.Text
  status    String   @default("new") // new | contacted | closed
  createdAt DateTime @default(now())
}

// Free-response timed test submissions (e.g. teacher-assigned worksheet tests).
// One row per student per test. Drafts are auto-saved during the test; once
// final=true the row is locked and no further edits are accepted.
model TimedSubmission {
  id         String   @id @default(cuid())
  testId     String   // e.g. "unit1-section-1-5"
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    Json     @default("{}") // { "q1": "...", "q2": "...", ... }
  startedAt  DateTime @default(now())
  final      Boolean  @default(false)
  finishedAt DateTime?
  timeMs     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([testId, userId])
  @@index([userId])
  @@index([testId])
}
